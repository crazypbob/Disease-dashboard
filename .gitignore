# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
scripts/.processed_pdfs.txt
scripts/.drive_sync_rels.tmp
scripts/.debug-verify-gmail-dump.txt
scripts/.pdf-gaps.csv
scripts/.nas-auto-pipeline.lock
*.pem

# local editor / tooling
.vscode/
.cursor/
.claude/

# local artifacts / logs
*.log
pipeline.log
pipeline-run-*.log
debug-*.log

# OCR pipeline runtime artifacts (do not commit)
ocr-pipeline/input/
ocr-pipeline/output/
ocr-pipeline/**/__pycache__/

# python caches
**/__pycache__/

# notebooks
notebooks/

# local data exports (do not commit)
scripts/results.xlsx
*.xlsx
*.pdf

# local env variants
env.nas

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
